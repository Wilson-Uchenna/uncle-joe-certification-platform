import { NextRequest, NextResponse } from "next/server";
import { auth } from "@/lib/auth";
import connectDB from "@/lib/db";
import { Result } from "@/models/Result";

export async function GET(
  req: NextRequest,
  { params }: { params: { examId: string } }
) {
  try {
    const session = await auth();
    if (!session?.user) {
      return NextResponse.json(
        { success: false, error: "Unauthorized" },
        { status: 401 }
      );
    }
    
    await connectDB();
    
    const result = await Result.findOne({
      examId: params.examId,
      userId: session.user.id
    }).lean();
    
    if (!result) {
      return NextResponse.json(
        { success: false, error: "Result not found" },
        { status: 404 }
      );
    }
    
    return NextResponse.json({ success: true, result });
    
  } catch (error) {
    console.error("Result GET error:", error);
    return NextResponse.json(
      { success: false, error: "Failed to fetch result" },
      { status: 500 }
    );
  }
}

import { NextRequest, NextResponse } from "next/server";
import { auth } from "@/lib/auth";
import connectDB from "@/lib/db";
import { Exam } from "@/models/Exam";
import { Payment } from "@/models/Payment";
import Paystack from "paystack-sdk";

const paystack = new Paystack(process.env.PAYSTACK_SECRET_KEY!);

export async function POST(req: NextRequest) {
  try {
    const session = await auth();
    if (!session?.user) {
      return NextResponse.json(
        { success: false, error: "Unauthorized" },
        { status: 401 }
      );
    }
    
    await connectDB();
    
    const { examId, amount, type } = await req.json();
    
    // Validate exam
    const exam = await Exam.findOne({
      _id: examId,
      userId: session.user.id,
      passed: true
    });
    
    if (!exam) {
      return NextResponse.json(
        { success: false, error: "Exam not found or not passed" },
        { status: 404 }
      );
    }
    
    // Generate reference
    const reference = `UJ-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
    
    // Create payment record
    await Payment.create({
      userId: session.user.id,
      examId,
      type,
      amount,
      currency: "NGN",
      provider: "paystack",
      providerReference: reference,
      status: "pending"
    });
    
    // Initialize Paystack
    const response = await paystack.transaction.initialize({
      email: session.user.email!,
      amount: amount * 100, // kobo
      reference,
      callback_url: `${process.env.NEXT_PUBLIC_APP_URL}/payment/verify`,
      metadata: {
        examId,
        userId: session.user.id,
        type
      }
    });
    
    return NextResponse.json({
      success: true,
      authorization_url: response.data.authorization_url,
      reference
    });
    
  } catch (error) {
    console.error("Payment initialize error:", error);
    return NextResponse.json(
      { success: false, error: "Failed to initialize payment" },
      { status: 500 }
    );
  }
}


